# ==============================================================================
# CloudFusion Backend Environment Variables (Production & Development)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
# In production on Render:
# SERVER_URL=https://cloudfusion-backend.onrender.com
# CLIENT_URL=https://cloudfusion-frontend.vercel.app
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database Connection (PostgreSQL / Supabase Transaction Connection Pooling)
DATABASE_URL="postgresql://postgres:password@your-db-host:5432/postgres?sslmode=require&pgbouncer=true"
# If using Supabase direct connection for migrations:
DIRECT_URL="postgresql://postgres:password@your-db-host:5432/postgres?sslmode=require"

# Security & AES-256-GCM Master Keys
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRW8mzNF655A-B3qX6r

# Google Drive & OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_developer_google_refresh_token

# Microsoft OneDrive Configuration
ONEDRIVE_CLIENT_ID=your_microsoft_onedrive_client_id
ONEDRIVE_CLIENT_SECRET=your_microsoft_onedrive_client_secret
ONEDRIVE_REFRESH_TOKEN=your_microsoft_onedrive_refresh_token

# Dropbox Configuration
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token

# AWS S3 Configuration
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# MEGA Cloud Configuration (Optional admin/developer fallback)
MEGA_EMAIL=your_mega_account_email
MEGA_PASSWORD=your_mega_account_password
